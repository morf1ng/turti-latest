# ═══════════════════════════════════════════════════════════════════════
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ TURTI
# Копировать имена в Vercel → Settings → Environment Variables.
# Ключи хранятся только здесь, на сервере. В браузер они не попадают.
# ═══════════════════════════════════════════════════════════════════════

# ─── Работает сразу, бесплатно ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # от @BotFather — уведомления о заказах
TELEGRAM_CHAT_ID=            # ваш chat id
SITE_URL=                    # https://ваш-домен — для ссылок возврата после оплаты
TELEGRAM_PUBLIC_URL=         # https://t.me/ваш_канал — ссылка «напишите в Telegram»

# ─── Хранилище: заказы, отзывы, оптовые заявки ───────────────────────
# Vercel → Storage → создать KV. Переменные добавятся автоматически.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Фото и видео в отзывах ──────────────────────────────────────────
# Vercel → Storage → создать Blob. Переменная добавится автоматически.
BLOB_READ_WRITE_TOKEN=          # Vercel Blob — фото отзывов и видео «Как мы делаем урбеч» (MOV/MP4 до 500 МБ)

# ─── Оплата: ЮKassa ──────────────────────────────────────────────────
# yookassa.ru → договор с ИП → Настройки → Ключи API
# Обязательно включить услугу «Чеки от ЮKassa» (54-ФЗ).
# Webhook: https://ваш-домен/api/pay-webhook, событие payment.succeeded
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1          # 1 = без НДС. Уточнить у бухгалтера.

# ─── Доставка СДЭК ───────────────────────────────────────────────────
# cdek.ru → договор для интернет-магазина → личный кабинет
CDEK_ACCOUNT=                # Client ID
CDEK_PASSWORD=               # Client Secret
CDEK_FROM_CODE=1074          # код города отправки, Махачкала
CDEK_TEST=                   # 1 — тестовый контур СДЭК

# ─── Доставка Ozon ───────────────────────────────────────────────────
# Условие Ozon: продавец должен быть представлен на Ozon,
# и товар должен быть и на Ozon, и на сайте.
# Кабинет продавца → Настройки → Управление частными приложениями
# Уровень доступа: seller-api.ozon-logistics
OZON_CLIENT_ID=             # Client-Id из кабинета продавца Ozon
OZON_CLIENT_SECRET=         # Client-Secret приложения seller-api.ozon-logistics

# ─── Яндекс Доставка (Махачкала) ─────────────────────────────────────
# delivery.yandex.ru → подключить B2B → получить OAuth-токен и ID платформы
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_PLATFORM_ID=

# ─── Доставка TURTI вручную (Махачкала) ──────────────────────────────
# 0 — скрыть вариант «доставка TURTI вручную»
TURTI_MANUAL_DELIVERY=1

# ─── Почта России ────────────────────────────────────────────────────
# Тариф на сайте считается через публичный калculator tariff.pochta.ru —
# для этого достаточно POST_FROM_INDEX, токен не нужен.
#
# Отправка заказов в «Отправку» (otpravka.pochta.ru) — только с договором:
# 1. Заключить договор с Почтой России как интернет-магазин.
# 2. Зарегистрироваться на https://otpravka.pochta.ru
# 3. Токен приложения: Ещё → Настройки → API → «Токен авторизации»
#    (или запросить у менеджера Почты). Спека: otpravka.pochta.ru/specification
# 4. Ключ пользователя: otpravka.pochta.ru/specification#/authorization-key
#    (base64 от логина:пароля от otpravka.pochta.ru)
POST_FROM_INDEX=             # индекс отправки, например 367000 (Махачкала)
POST_ACCESS_TOKEN=           # токен авторизации приложения (otpravka)
POST_USER_KEY=               # ключ авторизации пользователя (Basic, base64)

# ─── Поиск населённых пунктов ────────────────────────────────────────
# Нужен только если нет договора СДЭК: справочник ФИАС от DaData.
# Бесплатный тариф покрывает потребности небольшого магазина.
DADATA_TOKEN=

# ─── Карта пунктов выдачи ────────────────────────────────────────────
# Публичный ключ Яндекс.Карт. Обязательно ограничьте его по домену
# в кабинете разработчика, иначе им смогут пользоваться посторонние.
# Подставляется в index.html как window.YMAPS_KEY.
YMAPS_KEY=

# ═══════════════════════════════════════════════════════════════════════
# МОДУЛЬ QR / ОТЗЫВЫ / PUSH
# ═══════════════════════════════════════════════════════════════════════

# ─── Админка ─────────────────────────────────────────────────────────
# Без этой переменной /api/admin полностью закрыт. Придумайте длинную строку.
ADMIN_KEY=

# ─── Push-напоминания (VAPID) ────────────────────────────────────────
# Сгенерировать один раз:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:                # ваша почта

# Защита планировщика. Vercel Cron присылает этот ключ автоматически,
# если переменная задана. Без неё очередь напоминаний закрыта.
CRON_SECRET=

# ─── Медиа в отзывах ─────────────────────────────────────────────────
# MEDIA_PUBLIC=0 — фото и видео в отзывах не показываются на сайте
# (остаётся только текст). Аварийный выключатель, если пойдёт спам.
MEDIA_PUBLIC=1
